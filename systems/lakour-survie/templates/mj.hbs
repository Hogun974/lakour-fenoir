        <div class="survie-ressources">{{#each marche.ressources}}<label>{{libelle}} <input type="number" name="biens.{{cle}}" value="0" min="0"></label>{{/each}}</div>
        <label>{{localize "LAKOUR_SURVIE.Marche.MJ.Cibles"}} <select name="cibles" multiple>{{#each marche.cibles}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="effacerDette">
        <h3><i class="fa-solid fa-eraser"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.effacerDette"}}</h3>
