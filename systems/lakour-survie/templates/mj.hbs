<div class="survie-cadre">
  <nav class="survie-onglets">
    {{#each onglets}}<button type="button" class="{{#if actif}}actif{{/if}}" data-action="onglet" data-onglet="{{cle}}">{{libelle}}</button>{{/each}}
  </nav>
  {{#unless actif}}<p class="survie-avertissement"><i class="fa-solid fa-user-lock"></i> {{localize "LAKOUR_SURVIE.MJ.PasActif"}}</p>{{/unless}}
  {{#if bloque}}<p class="survie-avertissement"><i class="fa-solid fa-vault"></i> {{localize "LAKOUR_SURVIE.MJ.Bloque"}} <button type="button" data-action="ouvrirCoffre">{{localize "LAKOUR_SURVIE.MJ.Rouvrir"}}</button></p>{{/if}}
  {{#if quand}}<p class="survie-quand-mj"><i class="fa-solid fa-clock"></i> {{localize "LAKOUR_SURVIE.Bandeau.Jour" n=quand.jour}} · {{quand.heure}} · {{quand.dateTexte}}</p>{{/if}}
  {{#if resultat}}<div class="survie-resultat {{#if resultat.erreur}}erreur{{/if}}"><strong>{{resultat.titre}}</strong><pre>{{resultat.texte}}</pre></div>{{/if}}

  <section class="survie-corps">
    {{#if (eq onglet "partie")}}
    <div class="survie-formulaire" data-forme="demarrer">
      <h3><i class="fa-solid fa-flag"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.demarrer"}}</h3>
      {{#if demarree}}<p class="survie-avertissement">{{localize "LAKOUR_SURVIE.MJ.DejaDemarree"}}</p>{{/if}}
      <label>{{localize "LAKOUR_SURVIE.MJ.RegionDepart"}} <select name="region">{{#each regions}}<option value="{{valeur}}" {{#if choisi}}selected{{/if}}>{{libelle}}</option>{{/each}}</select></label>
      <label>{{localize "LAKOUR_SURVIE.Reglages.DateDepart.Nom"}} <input type="text" name="dateDepart" value="{{dateDepart}}" placeholder="AAAA-MM-JJ"></label>
      <label>{{localize "LAKOUR_SURVIE.MJ.Graine"}} <input type="text" name="graine" value=""></label>
      <fieldset><legend>{{localize "LAKOUR_SURVIE.MJ.Membres"}}</legend>
        {{#each survivants}}<label class="survie-case"><input type="checkbox" name="membres" data-liste="1" value="{{id}}" {{#if membre}}checked{{/if}}> {{nom}}</label>{{else}}<p class="survie-vide">{{localize "LAKOUR_SURVIE.MJ.AucunSurvivant"}}</p>{{/each}}
      </fieldset>
      <button type="button" class="principal" data-action="executer"><i class="fa-solid fa-play"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.demarrer"}}</button>
    </div>
    <div class="survie-formulaire" data-forme="avancer">
      <h3><i class="fa-solid fa-hourglass-half"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.avancer"}}</h3>
      <label>{{localize "LAKOUR_SURVIE.MJ.Quarts"}} <select name="quarts"><option value="1">1 {{localize "LAKOUR_SURVIE.MJ.Quart"}}</option><option value="2">2</option><option value="4">{{localize "LAKOUR_SURVIE.MJ.UnJour"}}</option><option value="28">{{localize "LAKOUR_SURVIE.MJ.UneSemaine"}}</option></select></label>
      <label>{{localize "LAKOUR_SURVIE.MJ.Raison"}} <input type="text" name="raison"></label>
      <label class="survie-case"><input type="checkbox" name="repos"> {{localize "LAKOUR_SURVIE.MJ.Repos"}}</label>
      <button type="button" class="principal" data-action="executer"><i class="fa-solid fa-forward"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.avancer"}}</button>
    </div>
    <div class="survie-formulaire" data-forme="feter">
      <h3><i class="fa-solid fa-champagne-glasses"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.feter"}}</h3>
      {{#if fetes.length}}<p>{{#each fetes}}<strong>{{nom}}</strong>{{#unless @last}}, {{/unless}}{{/each}}</p>{{else}}<p class="survie-vide">{{localize "LAKOUR_SURVIE.MJ.AucuneFete"}}</p>{{/if}}
      <label>{{localize "LAKOUR_SURVIE.MJ.Fete"}} <input type="text" name="fete" value="{{#each fetes}}{{#if @first}}{{cle}}{{/if}}{{/each}}"></label>
      <button type="button" data-action="executer"><i class="fa-solid fa-cake-candles"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.feter"}}</button>
    </div>
    {{/if}}

    {{#if (eq onglet "actions")}}
    <div class="survie-formulaires">
      <div class="survie-formulaire" data-forme="fouiller">
        <h3><i class="fa-solid fa-magnifying-glass"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.fouiller"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.MJ.Site"}} <select name="site">{{#each sitesIci}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.MJ.Cible"}} <select name="cible">{{#each cibles}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.MJ.Prudence"}} <select name="prudence">{{#each prudences}}<option value="{{valeur}}" {{#if choisi}}selected{{/if}}>{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.MJ.Quarts"}} <input type="number" name="quarts" value="1" min="1" max="8"></label>
        <label>{{localize "LAKOUR_SURVIE.MJ.Qui"}} <select name="membres" multiple>{{#each membres}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="explorer">
        <h3><i class="fa-solid fa-binoculars"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.explorer"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.Tableau.Region"}} <select name="region">{{#each regions}}<option value="{{valeur}}" {{#if choisi}}selected{{/if}}>{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.MJ.Prudence"}} <select name="prudence">{{#each prudences}}<option value="{{valeur}}" {{#if choisi}}selected{{/if}}>{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.MJ.Quarts"}} <input type="number" name="quarts" value="1" min="1" max="8"></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="construire">
        <h3><i class="fa-solid fa-hammer"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.construire"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.Abri.Installations"}} <select name="installation">{{#each installations}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.MJ.Quarts"}} <input type="number" name="quarts" value="1" min="1" max="40"></label>
        <label>{{localize "LAKOUR_SURVIE.MJ.Qui"}} <select name="membres" multiple>{{#each membres}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="reparer">
        <h3><i class="fa-solid fa-screwdriver"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.reparer"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.MJ.Quoi"}} <select name="installation">{{#each endommagees}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.MJ.Quarts"}} <input type="number" name="quarts" value="1" min="1" max="20"></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="voyager">
        <h3><i class="fa-solid fa-route"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.voyager"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.MJ.Vers"}} <select name="region">{{#each regions}}<option value="{{valeur}}" {{#if choisi}}selected{{/if}}>{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.MJ.Transport"}} <select name="transport">{{#each transports}}<option value="{{valeur}}" {{#if choisi}}selected{{/if}}>{{libelle}}</option>{{/each}}</select></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="installer">
        <h3><i class="fa-solid fa-house-flag"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.installer"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.MJ.Site"}} <select name="site">{{#each sites}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="demenager">
        <h3><i class="fa-solid fa-truck-ramp-box"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.demenager"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.MJ.Site"}} <select name="site">{{#each sites}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.MJ.Transport"}} <select name="transport">{{#each transports}}<option value="{{valeur}}" {{#if choisi}}selected{{/if}}>{{libelle}}</option>{{/each}}</select></label>
        <div class="survie-ressources">{{#each ressources}}<label>{{libelle}} <input type="number" name="emporter.{{cle}}" value="0" min="0"></label>{{/each}}</div>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="assaut">
        <h3><i class="fa-solid fa-shield-halved"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.assaut"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.MJ.Force"}} <input type="number" name="force" value="3" min="1" max="15"></label>
        <label>{{localize "LAKOUR_SURVIE.MJ.Type"}} <input type="text" name="type" value=""></label>
        <label>{{localize "LAKOUR_SURVIE.MJ.Description"}} <input type="text" name="description" value=""></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="ajuster">
        <h3><i class="fa-solid fa-scale-balanced"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.ajuster"}}</h3>
        <div class="survie-ressources">{{#each ressources}}<label>{{libelle}} <input type="number" name="stock.{{cle}}" value="0"></label>{{/each}}</div>
        <label>{{localize "LAKOUR_SURVIE.MJ.Raison"}} <input type="text" name="raison"></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
    </div>
    {{/if}}

    {{#if (eq onglet "groupe")}}
    <div class="survie-formulaires">
      <div class="survie-formulaire" data-forme="genererRecrue">
        <h3><i class="fa-solid fa-user-plus"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.genererRecrue"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.Tableau.Region"}} <select name="region">{{#each toutesRegions}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
        {{#if recrue}}<div class="survie-recrue"><strong>{{recrue.nom}}</strong>, {{recrue.age}} — {{recrue.raison}}<br><em>{{recrue.prix}}</em></div>{{/if}}
      </div>
      {{#if recrue}}
      <div class="survie-formulaire" data-forme="recruter">
        <h3><i class="fa-solid fa-handshake"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.recruter"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.MJ.Parleur"}} <select name="parleur">{{#each membres}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.MJ.Attitude"}} <select name="attitude"><option value="amicale">{{localize "LAKOUR_SURVIE.Attitudes.amicale"}}</option><option value="neutre" selected>{{localize "LAKOUR_SURVIE.Attitudes.neutre"}}</option><option value="mefiante">{{localize "LAKOUR_SURVIE.Attitudes.mefiante"}}</option><option value="hostile">{{localize "LAKOUR_SURVIE.Attitudes.hostile"}}</option></select></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      {{/if}}
      <div class="survie-formulaire" data-forme="demanderTest">
        <h3><i class="fa-solid fa-dice-six"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.demanderTest"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.MJ.Qui"}} <select name="acteur">{{#each membres}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.Fiche.Competences"}} <select name="competence">{{#each competences}}<option value="{{valeur}}" {{#if choisi}}selected{{/if}}>{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.Test.Difficulte"}} <select name="difficulte">{{#each difficultes}}<option value="{{valeur}}" {{#if choisi}}selected{{/if}}>{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.MJ.Titre2"}} <input type="text" name="titre"></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="fabriquer">
        <h3><i class="fa-solid fa-screwdriver-wrench"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.fabriquer"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.MJ.Recette"}} <select name="recette">{{#each recettes}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.MJ.Qui"}} <select name="acteur"><option value="">{{localize "LAKOUR_SURVIE.Atelier.LeMeilleur"}}</option>{{#each membres}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="affliction">
        <h3><i class="fa-solid fa-virus"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.affliction"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.MJ.Qui"}} <select name="acteur">{{#each membres}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.Fiche.Afflictions"}} <select name="affliction">{{#each afflictions}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.MJ.Action"}} <select name="action"><option value="donner">{{localize "LAKOUR_SURVIE.MJ.Donner"}}</option><option value="soigner">{{localize "LAKOUR_SURVIE.MJ.Soigner"}}</option></select></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="ajouterMembre">
        <h3><i class="fa-solid fa-user-group"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.ajouterMembre"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.MJ.Qui"}} <select name="acteur">{{#each survivants}}{{#unless membre}}<option value="{{id}}">{{nom}}</option>{{/unless}}{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.Creation.Statut"}} <select name="statut"><option value="compagnon">{{localize "LAKOUR_SURVIE.Statuts.compagnon"}}</option><option value="joueur">{{localize "LAKOUR_SURVIE.Statuts.joueur"}}</option><option value="pnj">{{localize "LAKOUR_SURVIE.Statuts.pnj"}}</option></select></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
    </div>
    {{/if}}

    {{#if (eq onglet "communaute")}}
    {{#if communaute}}
    <p class="survie-aide">{{localize "LAKOUR_SURVIE.Communaute.Aide"}}</p>
    <div class="survie-formulaires">
      <div class="survie-formulaire" data-forme="chef">
        <h3><i class="fa-solid fa-crown"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.chef"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.Esprit.Chef"}} <select name="chef">{{#each communaute.chef}}<option value="{{valeur}}" {{#if choisi}}selected{{/if}}>{{libelle}}</option>{{/each}}</select></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="parole">
        <h3><i class="fa-solid fa-handshake-simple"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.parole"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.Communaute.Parole"}} <select name="tenue"><option value="oui">{{localize "LAKOUR_SURVIE.Communaute.Tenue"}}</option><option value="non">{{localize "LAKOUR_SURVIE.Communaute.Manquee"}}</option></select></label>
        <label>{{localize "LAKOUR_SURVIE.MJ.Raison"}} <input type="text" name="raison"></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="entente">
        <h3><i class="fa-solid fa-people-arrows"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.entente"}} : {{communaute.entente.valeur}} ({{communaute.entente.libelle}})</h3>
        <label>{{localize "LAKOUR_SURVIE.Communaute.Delta"}} <input type="number" name="delta" value="1" min="-6" max="6"></label>
        <label>{{localize "LAKOUR_SURVIE.MJ.Raison"}} <input type="text" name="raison"></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
    </div>
    <p class="survie-sens {{communaute.couleur.bande}}"><strong>{{localize "LAKOUR_SURVIE.Communaute.Couleur"}}</strong> : {{communaute.couleur.libelle}} ({{communaute.couleur.moyenne}}) · <strong>{{localize "LAKOUR_SURVIE.Communaute.Reputation"}}</strong> : {{communaute.reputation.libelle}} ({{communaute.reputation.moyenne}})</p>
    <table class="survie-table">
      <thead><tr><th>{{localize "LAKOUR_SURVIE.Fiche.Nom"}}</th><th>{{localize "LAKOUR_SURVIE.Esprit.Regard"}}</th><th>{{localize "LAKOUR_SURVIE.Esprit.Foi"}}</th><th>{{localize "LAKOUR_SURVIE.Esprit.SensMoral"}}</th><th>{{localize "LAKOUR_SURVIE.Esprit.Reputation"}}</th><th>{{localize "LAKOUR_SURVIE.Esprit.Autorite"}}</th><th>{{localize "LAKOUR_SURVIE.Communaute.Signes"}}</th></tr></thead>
      <tbody>{{#each communaute.membres}}<tr><td>{{#if chef}}👑 {{/if}}{{nom}}{{#if enfant}} <small>({{localize "LAKOUR_SURVIE.Communaute.Enfant"}})</small>{{/if}}{{#unless actif}} <small>({{localize "LAKOUR_SURVIE.Esprit.NonTire"}})</small>{{/unless}}</td><td>{{regard}}</td><td>{{foi}}{{#if enFaute}} <em>{{localize "LAKOUR_SURVIE.Esprit.EnFaute"}}</em>{{/if}}</td>
        <td class="survie-sens {{sens.bande}}">{{sens.valeur}} {{sens.libelle}}</td><td>{{reputation.valeur}}</td><td>{{autorite}}</td><td>{{#if lacher}}{{lacher}}/3{{/if}}{{#if chance}} 🍀{{chance}}{{/if}}{{#if projet}} {{projet}}{{/if}}</td></tr>{{/each}}</tbody>
    </table>

    <h3><i class="fa-solid fa-door-closed"></i> {{localize "LAKOUR_SURVIE.Abri.Porte"}}</h3>
    <p>{{#if communaute.liste}}<strong>{{localize "LAKOUR_SURVIE.Abri.Manque"}}</strong> : {{communaute.liste}}{{else}}<em>{{localize "LAKOUR_SURVIE.Abri.RienNeManque"}}</em>{{/if}}</p>
    <div class="survie-formulaires">
      {{#each communaute.visiteurs}}
      <div class="survie-formulaire" data-forme="porte">
        <h3><i class="fa-solid fa-person"></i> {{nom}}, {{age}} — {{profil}}{{#if revient}} ↺{{/if}}</h3>
        <p>{{demande}}{{#if apporte}}<br><em>{{localize "LAKOUR_SURVIE.Communaute.Apporte" liste=apporte}}</em>{{/if}}</p>
        {{#if secret}}<p class="survie-avertissement secret survie-sens {{secret.bande}}"><i class="fa-solid fa-user-secret"></i> {{localize "LAKOUR_SURVIE.Communaute.VraieCouleur"}} : {{secret.libelle}} ({{secret.valeur}})</p>{{/if}}
        <input type="hidden" name="visiteur" value="{{id}}">
        <label>{{localize "LAKOUR_SURVIE.Communaute.Decision"}} <select name="decision"><option value="accueillir">{{localize "LAKOUR_SURVIE.Communaute.Accueillir"}}</option><option value="refuser">{{localize "LAKOUR_SURVIE.Communaute.Refuser"}}</option>{{#if apporte}}<option value="trahir">{{localize "LAKOUR_SURVIE.Communaute.Trahir"}}</option>{{/if}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.Communaute.Vote"}} <select name="vote">{{#each ../communaute.votesOptions}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label class="survie-case"><input type="checkbox" name="circonstances"> {{localize "LAKOUR_SURVIE.Communaute.Circonstances"}}</label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      {{else}}<p class="survie-vide">{{localize "LAKOUR_SURVIE.Communaute.PersonneALaPorte"}}</p>{{/each}}
      <div class="survie-formulaire" data-forme="frapper">
        <h3><i class="fa-solid fa-hand-back-fist"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.frapper"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.Communaute.Profil"}} <select name="profil">{{#each communaute.profils}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
    </div>

    <h3><i class="fa-solid fa-check-to-slot"></i> {{localize "LAKOUR_SURVIE.Communaute.Votes"}}</h3>
    <ul class="survie-liste-simple">{{#each communaute.votes}}<li><strong>{{#if question}}{{question}}{{else}}{{acteLibelle}}{{/if}}</strong> — {{localize "LAKOUR_SURVIE.Communaute.Resultat" pour=resultat.pour contre=resultat.contre abstention=resultat.abstention}}{{#if decideLibelle}} → {{decideLibelle}}{{/if}}</li>{{else}}<li class="survie-vide">—</li>{{/each}}</ul>
    <div class="survie-formulaires">
      <div class="survie-formulaire" data-forme="voter">
        <h3><i class="fa-solid fa-box-archive"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.voter"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.Communaute.Question"}} <input type="text" name="question"></label>
        <label>{{localize "LAKOUR_SURVIE.Communaute.Acte"}} <select name="acte">{{#each communaute.actes}}<option value="{{valeur}}" {{#if choisi}}selected{{/if}}>{{libelle}}</option>{{/each}}</select></label>
        <label class="survie-case"><input type="checkbox" name="circonstances"> {{localize "LAKOUR_SURVIE.Communaute.Circonstances"}}</label>
        <p class="survie-aide">{{localize "LAKOUR_SURVIE.Communaute.VoteAide"}}</p>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="decider">
        <h3><i class="fa-solid fa-gavel"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.decider"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.Communaute.Vote"}} <select name="vote">{{#each communaute.votesOptions}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.Communaute.Decision"}} <select name="decision"><option value="pour">{{localize "LAKOUR_SURVIE.Communaute.Faire"}}</option><option value="contre">{{localize "LAKOUR_SURVIE.Communaute.NePasFaire"}}</option></select></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="acteMoral">
        <h3><i class="fa-solid fa-scale-unbalanced"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.acteMoral"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.MJ.Qui"}} <select name="membres" multiple>{{#each communaute.membresOptions}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.Communaute.Acte"}} <select name="acte">{{#each communaute.actes}}<option value="{{valeur}}" {{#if choisi}}selected{{/if}}>{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.Communaute.Vote"}} <select name="vote">{{#each communaute.votesOptions}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label class="survie-case"><input type="checkbox" name="circonstances"> {{localize "LAKOUR_SURVIE.Communaute.Circonstances"}}</label>
        <label class="survie-case"><input type="checkbox" name="temoins" checked> {{localize "LAKOUR_SURVIE.Communaute.Temoins"}}</label>
        <label class="survie-case"><input type="checkbox" name="journal"> {{localize "LAKOUR_SURVIE.Communaute.AuJournal"}}</label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="signe">
        <h3><i class="fa-solid fa-wind"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.signe"}}</h3>
        <p class="survie-aide">{{localize "LAKOUR_SURVIE.Communaute.SigneAide"}}</p>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
    </div>

    <h3><i class="fa-solid fa-coins"></i> {{localize "LAKOUR_SURVIE.Communaute.Tributs"}}</h3>
    <div class="survie-formulaires">
      {{#each communaute.tributs}}
      <div class="survie-formulaire" data-forme="tribut">
        <h3>{{bande}} — {{etatLibelle}}</h3>
        <p>{{demandeTexte}} · {{localize "LAKOUR_SURVIE.Communaute.Prochain" n=prochain}} · {{localize "LAKOUR_SURVIE.Communaute.Payes" n=payes}}{{#if sens}} · <span class="survie-sens {{sens.bande}}">{{sens.libelle}}</span>{{/if}}</p>
        {{#if actif}}<input type="hidden" name="tribut" value="{{id}}">
        <label>{{localize "LAKOUR_SURVIE.Communaute.Payer"}} <select name="paye"><option value="oui">{{localize "LAKOUR_SURVIE.Communaute.Paye"}}</option><option value="non">{{localize "LAKOUR_SURVIE.Communaute.Refuse"}}</option></select></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>{{/if}}
      </div>
      {{else}}<p class="survie-vide">—</p>{{/each}}
    </div>

    <h3><i class="fa-solid fa-code-fork"></i> {{localize "LAKOUR_SURVIE.Communaute.Groupes"}}</h3>
    <div class="survie-formulaires">
      <div class="survie-formulaire" data-forme="separer">
        <h3>{{localize "LAKOUR_SURVIE.MJ.Formes.separer"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.Communaute.Partants"}} <select name="membres" multiple>{{#each communaute.membresOptions}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.Communaute.AbriVa"}} <select name="abriVaAux"><option value="restants">{{localize "LAKOUR_SURVIE.Communaute.Restants"}}</option><option value="partants">{{localize "LAKOUR_SURVIE.Communaute.PartantsAbri"}}</option></select></label>
        <label>{{localize "LAKOUR_SURVIE.Communaute.NomGroupe"}} <input type="text" name="nom"></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      {{#if communaute.aDesCommunautes}}
      <div class="survie-formulaire" data-forme="fusionner">
        <h3>{{localize "LAKOUR_SURVIE.MJ.Formes.fusionner"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.Communaute.AutreGroupe"}} <select name="communaute">{{#each communaute.communautes}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      {{/if}}
    </div>
    {{else}}<p class="survie-vide">{{localize "LAKOUR_SURVIE.Bandeau.Attente"}}</p>{{/if}}
    {{/if}}

    {{#if (eq onglet "menaces")}}
    <h3><i class="fa-solid fa-triangle-exclamation"></i> {{localize "LAKOUR_SURVIE.MJ.Menaces"}}</h3>
    <p class="survie-aide">{{localize "LAKOUR_SURVIE.MJ.AideMenaces"}}</p>
    <ul class="survie-menaces">
      {{#each menaces}}
      <li><span class="survie-quand">J{{jour}}</span> <strong>{{typeLibelle}}</strong>{{#if force}} ({{localize "LAKOUR_SURVIE.MJ.Force"}} {{force}}){{/if}} — {{texte}}
        {{#if chef}}<br><em class="survie-sens {{chef.bande}}"><i class="fa-solid fa-user-tie"></i> {{chef.texte}} ({{chef.bandeLibelle}})</em>
        {{#if chef.ultimatum}}<button type="button" data-action="menace" data-id="{{id}}" data-mode="ultimatum"><i class="fa-solid fa-coins"></i> {{localize "LAKOUR_SURVIE.MJ.Ultimatum"}}</button>{{/if}}
        {{#if chef.rejoindre}}<button type="button" data-action="menace" data-id="{{id}}" data-mode="rejoindre"><i class="fa-solid fa-door-open"></i> {{localize "LAKOUR_SURVIE.MJ.Rejoindre"}}</button>{{/if}}{{/if}}
        {{#if force}}<button type="button" data-action="menace" data-id="{{id}}" data-mode="assaut"><i class="fa-solid fa-shield-halved"></i> {{localize "LAKOUR_SURVIE.MJ.Resoudre"}}</button>{{/if}}
        <button type="button" data-action="menace" data-id="{{id}}" data-mode="ecarter"><i class="fa-solid fa-xmark"></i> {{localize "LAKOUR_SURVIE.MJ.Ecarter"}}</button></li>
      {{else}}<li class="survie-vide">{{localize "LAKOUR_SURVIE.MJ.AucuneMenace"}}</li>{{/each}}
    </ul>
    <div class="survie-formulaire" data-forme="rencontre">
      <h3><i class="fa-solid fa-person-walking-dashed-line-arrow-right"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.rencontre"}}</h3>
      <label>{{localize "LAKOUR_SURVIE.Tableau.Region"}} <select name="region">{{#each regions}}<option value="{{valeur}}" {{#if choisi}}selected{{/if}}>{{libelle}}</option>{{/each}}</select></label>
      <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
    </div>
    <h3><i class="fa-solid fa-eye"></i> {{localize "LAKOUR_SURVIE.MJ.Paliers"}}</h3>
    <ul class="survie-menaces">
      {{#each paliers}}<li><span class="survie-quand">J{{jour}}</span> <strong>{{palier}}</strong> ({{visibilite}}) {{#if uuid}}<button type="button" data-action="tirerPalier" data-uuid="{{uuid}}"><i class="fa-solid fa-dice"></i> {{table}}</button>{{else}}{{table}}{{/if}}</li>
      {{else}}<li class="survie-vide">—</li>{{/each}}
    </ul>
    {{/if}}

    {{#if (eq onglet "monde")}}
    {{#if monde}}
    <p class="survie-avertissement secret"><i class="fa-solid fa-user-secret"></i> {{localize "LAKOUR_SURVIE.MJ.Secret"}}</p>
    {{#if monde.cyclone}}<p><i class="fa-solid fa-hurricane"></i> {{monde.cyclone.nom}} — {{monde.cyclone.alerte}} (J{{monde.cyclone.arrivee}}, {{localize "LAKOUR_SURVIE.MJ.Force"}} {{monde.cyclone.force}}) : {{monde.cyclone.trajectoire}}</p>{{/if}}
    {{#if monde.eruption}}<p><i class="fa-solid fa-volcano"></i> {{localize "LAKOUR_SURVIE.MJ.Eruption"}} J{{monde.eruption.debut}}–J{{monde.eruption.fin}}</p>{{/if}}
    <table class="survie-table monde">
      <thead><tr><th>{{localize "LAKOUR_SURVIE.Tableau.Region"}}</th><th>{{localize "LAKOUR_SURVIE.Tableau.Infestation"}}</th><th>{{localize "LAKOUR_SURVIE.MJ.Reste"}}</th><th>{{localize "LAKOUR_SURVIE.Tableau.Factions"}}</th><th>{{localize "LAKOUR_SURVIE.MJ.Routes"}}</th><th>{{localize "LAKOUR_SURVIE.MJ.Evenements"}}</th></tr></thead>
      <tbody>{{#each monde.regions}}<tr><td>{{nom}}{{#if abris}}<br><small>{{abris}}</small>{{/if}}</td><td>{{infestation}} <small>{{bande}}</small></td><td>{{pillage}} %</td><td>{{factions}}</td><td>{{routes}}</td><td>{{evenements}}</td></tr>{{/each}}</tbody>
    </table>
    <h3>{{localize "LAKOUR_SURVIE.MJ.Hordes"}}</h3>
    <ul class="survie-liste-simple">{{#each monde.hordes}}<li>{{region}} — {{localize "LAKOUR_SURVIE.MJ.Taille"}} {{taille}}{{#if cap}} → {{cap}}{{/if}}</li>{{else}}<li class="survie-vide">—</li>{{/each}}</ul>
    <h3>{{localize "LAKOUR_SURVIE.MJ.JournalSecret"}}</h3>
    <ul class="survie-journal">{{#each monde.journal}}<li><span class="survie-quand">J{{jour}}</span> {{texte}}</li>{{else}}<li class="survie-vide">—</li>{{/each}}</ul>
    {{else}}<p class="survie-vide">{{localize "LAKOUR_SURVIE.MJ.MondeFerme"}}</p>{{/if}}
    {{/if}}
  </section>
</div>
