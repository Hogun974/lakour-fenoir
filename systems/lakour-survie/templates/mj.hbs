        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="ouvrirMarche">
        <h3><i class="fa-solid fa-store"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.ouvrirMarche"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.Marche.MJ.Modele"}} <select name="modele">{{#each marche.modeles}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.Marche.MJ.Foire"}} <select name="foire">{{#each marche.foires}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.Marche.MJ.Nom"}} <input type="text" name="nom"></label>
        <label>{{localize "LAKOUR_SURVIE.Marche.MJ.JourSemaine"}} <select name="jourSemaine">{{#each marche.jours}}<option value="{{valeur}}" {{#if choisi}}selected{{/if}}>{{libelle}}</option>{{/each}}</select></label>
        <label class="survie-case"><input type="checkbox" name="accueil"> {{localize "LAKOUR_SURVIE.Marche.MJ.Accueillir"}}</label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="gererMarche">
        <h3><i class="fa-solid fa-handshake"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.gererMarche"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.Marche.MJ.Marche"}} <select name="marche">{{#each marche.choixMarches}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.MJ.Action"}} <select name="geste">{{#each marche.gestes}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.Marche.MJ.Par"}} <input type="text" name="par" placeholder="{{localize "LAKOUR_SURVIE.Marche.LeGroupe"}}"></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="evenementDeMarche">
        <h3><i class="fa-solid fa-dice"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.evenementDeMarche"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.Marche.MJ.Stade"}} <select name="stade">{{#each marche.choixStades}}<option value="{{valeur}}" {{#if choisi}}selected{{/if}}>{{libelle}}</option>{{/each}}</select></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="dementirPrejuge">
        <h3><i class="fa-solid fa-scale-unbalanced-flip"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.dementirPrejuge"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.Marche.MJ.Cible"}} <select name="cible">{{#each marche.cibles}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="rumeur">
        <h3><i class="fa-solid fa-comment-dots"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.rumeur"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.Marche.MJ.Sujet"}} <input type="text" name="sujet" placeholder="{{localize "LAKOUR_SURVIE.Marche.LeGroupe"}}"></label>
        <label>{{localize "LAKOUR_SURVIE.Marche.MJ.Texte"}} <input type="text" name="texte"></label>
        <label class="survie-case"><input type="checkbox" name="vraie" checked> {{localize "LAKOUR_SURVIE.Marche.MJ.Vraie"}}</label>
        <label class="survie-case"><input type="checkbox" name="malveillant"> {{localize "LAKOUR_SURVIE.Marche.MJ.Malveillant"}}</label>
        <label>{{localize "LAKOUR_SURVIE.Marche.MJ.Auteur"}} <input type="text" name="auteur"></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="dementir">
        <h3><i class="fa-solid fa-comment-slash"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.dementir"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.Marche.MJ.Rumeur"}} <select name="id">{{#each marche.choixRumeurs}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.Marche.MJ.Preuve"}} <select name="preuve">{{#each marche.preuves}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="creerMarchand">
        <h3><i class="fa-solid fa-user-plus"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.creerMarchand"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.Marche.MJ.Marchand"}} <select name="cle">{{#each marche.marchands}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="signe">
        <h3><i class="fa-solid fa-stamp"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.signe"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.Marche.MJ.Signe"}} <input type="text" name="signe" value="{{marche.signe}}"></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
    </div>
    {{/if}}

    {{#if (eq onglet "monde")}}
    {{#if monde}}
    <p class="survie-avertissement secret"><i class="fa-solid fa-user-secret"></i> {{localize "LAKOUR_SURVIE.MJ.Secret"}}</p>
    {{#if monde.cyclone}}<p><i class="fa-solid fa-hurricane"></i> {{monde.cyclone.nom}} — {{monde.cyclone.alerte}} (J{{monde.cyclone.arrivee}}, {{localize "LAKOUR_SURVIE.MJ.Force"}} {{monde.cyclone.force}}) : {{monde.cyclone.trajectoire}}</p>{{/if}}
    {{#if monde.eruption}}<p><i class="fa-solid fa-volcano"></i> {{localize "LAKOUR_SURVIE.MJ.Eruption"}} J{{monde.eruption.debut}}–J{{monde.eruption.fin}}</p>{{/if}}
    <table class="survie-table monde">
      <thead><tr><th>{{localize "LAKOUR_SURVIE.Tableau.Region"}}</th><th>{{localize "LAKOUR_SURVIE.Tableau.Infestation"}}</th><th>{{localize "LAKOUR_SURVIE.MJ.Reste"}}</th><th>{{localize "LAKOUR_SURVIE.Tableau.Factions"}}</th><th>{{localize "LAKOUR_SURVIE.MJ.Routes"}}</th><th>{{localize "LAKOUR_SURVIE.MJ.Evenements"}}</th></tr></thead>
      <tbody>{{#each monde.regions}}<tr><td>{{nom}}{{#if abris}}<br><small>{{abris}}</small>{{/if}}</td><td>{{infestation}} <small>{{bande}}</small></td><td>{{pillage}} %</td><td>{{factions}}</td><td>{{routes}}</td><td>{{evenements}}</td></tr>{{/each}}</tbody>
    </table>
    <h3>{{localize "LAKOUR_SURVIE.MJ.Hordes"}}</h3>
    <ul class="survie-liste-simple">{{#each monde.hordes}}<li>{{region}} — {{localize "LAKOUR_SURVIE.MJ.Taille"}} {{taille}}{{#if cap}} → {{cap}}{{/if}}</li>{{else}}<li class="survie-vide">—</li>{{/each}}</ul>
    <h3>{{localize "LAKOUR_SURVIE.MJ.JournalSecret"}}</h3>
    <ul class="survie-journal">{{#each monde.journal}}<li><span class="survie-quand">J{{jour}}</span> {{texte}}</li>{{else}}<li class="survie-vide">—</li>{{/each}}</ul>
    {{else}}<p class="survie-vide">{{localize "LAKOUR_SURVIE.MJ.MondeFerme"}}</p>{{/if}}
    {{/if}}
  </section>
</div>
