        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="crediter">
        <h3><i class="fa-solid fa-pen-to-square"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.crediter"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.Marche.MJ.Boutique"}} <select name="boutique">{{#each marche.choixBoutiques}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <div class="survie-ressources">{{#each marche.ressources}}<label>{{libelle}} <input type="number" name="biens.{{cle}}" value="0" min="0"></label>{{/each}}</div>
        <label>{{localize "LAKOUR_SURVIE.Marche.MJ.Cibles"}} <select name="cibles" multiple>{{#each marche.cibles}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="rendre">
        <h3><i class="fa-solid fa-hand-holding"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.rendre"}}</h3>
