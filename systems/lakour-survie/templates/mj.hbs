        <label>{{localize "LAKOUR_SURVIE.MJ.Qui"}} <select name="membres" multiple>{{#each membres}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="apprendre">
        <h3><i class="fa-solid fa-book-open"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.apprendre"}}</h3>
        <p class="survie-aide">{{localize "LAKOUR_SURVIE.Savoirs.AideApprendre"}}</p>
        <label>{{localize "LAKOUR_SURVIE.Savoirs.Eleve"}} <select name="acteur">{{#each membres}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.Savoirs.Savoir"}} <select name="savoir">{{#each savoirsListe}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.Savoirs.Source"}} <select name="source">{{#each sources}}<option value="{{valeur}}" {{#if choisi}}selected{{/if}}>{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.Savoirs.Maitre"}} <select name="maitre"><option value="">—</option>{{#each membresConfiance}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="gagnerConfiance">
        <h3><i class="fa-solid fa-hand-holding-heart"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.gagnerConfiance"}}</h3>
        <label>{{localize "LAKOUR_SURVIE.Savoirs.Gramoune"}} <select name="acteur">{{#each membresConfiance}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.MJ.Parleur"}} <select name="parleur">{{#each membres}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="dicter">
        <h3><i class="fa-solid fa-feather"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.dicter"}}</h3>
        <p class="survie-aide">{{localize "LAKOUR_SURVIE.Savoirs.AideDicter"}}</p>
        <label>{{localize "LAKOUR_SURVIE.Savoirs.Gramoune"}} <select name="acteur">{{#each membresConfiance}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.Savoirs.Scribe"}} <select name="scribe">{{#each membres}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="apprivoiser">
        <h3><i class="fa-solid fa-dog"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.apprivoiser"}}</h3>
        <p class="survie-aide">{{localize "LAKOUR_SURVIE.Savoirs.AideChien"}}{{#if chienErrant}} {{localize "LAKOUR_SURVIE.Savoirs.ChienEnCours" n=chienErrant.confiance}}{{/if}}</p>
        <label>{{localize "LAKOUR_SURVIE.MJ.Qui"}} <select name="acteur">{{#each membres}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
      </div>
    </div>
    {{/if}}

    {{#if (eq onglet "menaces")}}
    <h3><i class="fa-solid fa-triangle-exclamation"></i> {{localize "LAKOUR_SURVIE.MJ.Menaces"}}</h3>
    <p class="survie-aide">{{localize "LAKOUR_SURVIE.MJ.AideMenaces"}}</p>
    <ul class="survie-menaces">
      {{#each menaces}}
      <li><span class="survie-quand">J{{jour}}</span> <strong>{{typeLibelle}}</strong>{{#if force}} ({{localize "LAKOUR_SURVIE.MJ.Force"}} {{force}}){{/if}} — {{texte}}
        {{#if force}}<button type="button" data-action="menace" data-id="{{id}}" data-mode="assaut"><i class="fa-solid fa-shield-halved"></i> {{localize "LAKOUR_SURVIE.MJ.Resoudre"}}</button>{{/if}}
        <button type="button" data-action="menace" data-id="{{id}}" data-mode="ecarter"><i class="fa-solid fa-xmark"></i> {{localize "LAKOUR_SURVIE.MJ.Ecarter"}}</button></li>
      {{else}}<li class="survie-vide">{{localize "LAKOUR_SURVIE.MJ.AucuneMenace"}}</li>{{/each}}
    </ul>
    <div class="survie-formulaire" data-forme="rencontre">
      <h3><i class="fa-solid fa-person-walking-dashed-line-arrow-right"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.rencontre"}}</h3>
      <label>{{localize "LAKOUR_SURVIE.Tableau.Region"}} <select name="region">{{#each regions}}<option value="{{valeur}}" {{#if choisi}}selected{{/if}}>{{libelle}}</option>{{/each}}</select></label>
      <button type="button" data-action="executer">{{localize "LAKOUR_SURVIE.MJ.Faire"}}</button>
    </div>
    <h3><i class="fa-solid fa-eye"></i> {{localize "LAKOUR_SURVIE.MJ.Paliers"}}</h3>
    <ul class="survie-menaces">
      {{#each paliers}}<li><span class="survie-quand">J{{jour}}</span> <strong>{{palier}}</strong> ({{visibilite}}) {{#if uuid}}<button type="button" data-action="tirerPalier" data-uuid="{{uuid}}"><i class="fa-solid fa-dice"></i> {{table}}</button>{{else}}{{table}}{{/if}}</li>
      {{else}}<li class="survie-vide">—</li>{{/each}}
    </ul>
    {{/if}}

    {{#if (eq onglet "marche")}}
    <h3><i class="fa-solid fa-scale-balanced"></i> {{localize "LAKOUR_SURVIE.Marche.MJ.Cours"}}</h3>
    <p class="survie-aide">{{localize "LAKOUR_SURVIE.Marche.MJ.AideCours"}}</p>
    <p>{{#each marche.cours}}<strong>{{libelle}}</strong> {{valeur}}{{#unless @last}} · {{/unless}}{{/each}}</p>
    <h3><i class="fa-solid fa-stairs"></i> {{localize "LAKOUR_SURVIE.Marche.MJ.Stades"}}</h3>
    <ul class="survie-liste-simple">{{#each marche.stades}}<li>{{#if ouvert}}✔{{else}}✘{{/if}} <strong>{{libelle}}</strong> — {{texte}}</li>{{/each}}</ul>

    <h3><i class="fa-solid fa-book"></i> {{localize "LAKOUR_SURVIE.Marche.MJ.Boutiques"}}</h3>
    <ul class="survie-liste-simple">{{#each marche.boutiques}}<li><strong>{{nom}}</strong>{{#if tenancier}} ({{tenancier}}){{/if}} — {{localize "LAKOUR_SURVIE.Marche.MJ.Dette" dette=dette plafond=plafond}}{{#if traine}} <span class="survie-alerte">{{localize "LAKOUR_SURVIE.Marche.MJ.Traine"}}</span>{{/if}}</li>{{else}}<li class="survie-vide">—</li>{{/each}}</ul>
    <h3><i class="fa-solid fa-store"></i> {{localize "LAKOUR_SURVIE.Marche.MJ.Marches"}}</h3>
    <ul class="survie-liste-simple">{{#each marche.marches}}<li><strong>{{nom}}</strong> — {{jour}}{{#if hote}} · {{localize "LAKOUR_SURVIE.Marche.MJ.Hote"}} {{hote}}{{/if}}{{#if rompue}} · <span class="survie-alerte">{{localize "LAKOUR_SURVIE.Marche.MJ.TreveRompue"}}</span>{{/if}}{{#if bastions}} · {{bastions}}{{/if}}</li>{{else}}<li class="survie-vide">—</li>{{/each}}</ul>
    <h3><i class="fa-solid fa-comments"></i> {{localize "LAKOUR_SURVIE.Marche.MJ.Rumeurs"}}</h3>
    <ul class="survie-journal">{{#each marche.rumeurs}}<li><span class="survie-quand">J{{jour}}</span> {{texte}}{{#if dementie}} <em>({{localize "LAKOUR_SURVIE.Marche.MJ.Dementie"}})</em>{{/if}}{{#if verite}} <span class="survie-secret">[{{verite}}]</span>{{/if}}</li>{{else}}<li class="survie-vide">—</li>{{/each}}</ul>

    <div class="survie-formulaires">
      <div class="survie-formulaire" data-forme="troquer">
        <h3><i class="fa-solid fa-right-left"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.troquer"}}</h3>
        <p class="survie-aide">{{localize "LAKOUR_SURVIE.Marche.MJ.AideTroc"}}</p>
        <fieldset><legend>{{localize "LAKOUR_SURVIE.Marche.MJ.Donne"}}</legend><div class="survie-ressources">{{#each marche.ressources}}<label>{{libelle}} <input type="number" name="donne.{{cle}}" value="0" min="0"></label>{{/each}}</div></fieldset>
        <fieldset><legend>{{localize "LAKOUR_SURVIE.Marche.MJ.Recoit"}}</legend><div class="survie-ressources">{{#each marche.ressources}}<label>{{libelle}} <input type="number" name="recoit.{{cle}}" value="0" min="0"></label>{{/each}}</div></fieldset>
        <label>{{localize "LAKOUR_SURVIE.Marche.MJ.Pnj"}} <select name="pnj">{{#each marche.pnj}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.Marche.MJ.Cibles"}} <select name="cibles" multiple>{{#each marche.cibles}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.Marche.MJ.Faction"}} <select name="faction">{{#each marche.factions}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label>{{localize "LAKOUR_SURVIE.Marche.MJ.Marche"}} <select name="marche">{{#each marche.choixMarches}}<option value="{{valeur}}">{{libelle}}</option>{{/each}}</select></label>
        <label class="survie-case"><input type="checkbox" name="accepter"> {{localize "LAKOUR_SURVIE.Marche.MJ.Accepter"}}</label>
        <button type="button" data-action="executer"><i class="fa-solid fa-calculator"></i> {{localize "LAKOUR_SURVIE.Marche.MJ.Evaluer"}}</button>
      </div>
      <div class="survie-formulaire" data-forme="ouvrirBoutique">
        <h3><i class="fa-solid fa-shop"></i> {{localize "LAKOUR_SURVIE.MJ.Formes.ouvrirBoutique"}}</h3>
