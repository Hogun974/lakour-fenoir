      "type": "text",
      "name": "",
      "description": "<p>Il bute contre la clôture, recommence, recommence encore ; au bout d'un moment, il la longe pour chercher un passage.</p>",
      "range": [
        3,
        3
      ],
      "weight": 1,
      "drawn": false,
